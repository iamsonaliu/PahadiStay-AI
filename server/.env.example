PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: when omitted or unreachable, the API runs in in-memory mode.
MONGO_URI=

# Optional in development; set a strong value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: when omitted, AI endpoints use deterministic fallbacks.
GEMINI_API_KEY=

# Optional: when omitted, booking emails are logged as dry-runs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OWNER_NOTIFY_EMAIL=
